  "dependencies": {
    "next": "15.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.7.3",
    "@playwright/test": "1.55.0",
    "prettier": "3.6.2"
  }
}
