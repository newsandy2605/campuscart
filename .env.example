APP_ENV=development
DEV_OTP_ECHO=true
JWT_SECRET=replace-me
HANDOFF_SECRET=replace-me

# Gmail OTP (fill these to send real email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@campuscart.local
SMTP_STARTTLS=true

# Twilio Verify (fill these to send real SMS OTP)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay (switch PAYMENT_PROVIDER to razorpay after adding credentials)
PAYMENT_PROVIDER=local
RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Campus verification: domain_or_admin | admin_only | development_allow_contact
CAMPUS_VERIFICATION_MODE=domain_or_admin

# Media storage
STORAGE_PROVIDER=local
MEDIA_DIR=/app/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
