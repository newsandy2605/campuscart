# CampusCart backend configuration
APP_ENV=development
DEV_OTP_ECHO=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Gmail SMTP - leave SMTP_HOST blank for local OTP echo mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@campuscart.local
SMTP_STARTTLS=true

# Twilio Verify SMS OTP - leave SMS_PROVIDER blank for local OTP echo mode
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Payments - local keeps development functional; switch to razorpay after adding credentials
PAYMENT_PROVIDER=local
RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# App secrets
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
HANDOFF_SECRET=REPLACE_WITH_A_RANDOM_HANDOFF_SECRET
PASSWORD_RESET_TTL_SECONDS=900

# Campus verification
CAMPUS_VERIFICATION_MODE=domain_or_admin

# Media storage: use local for development or s3 for production
STORAGE_PROVIDER=local
MEDIA_DIR=/app/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional development seed overrides (defaults keep the bundled demo campus usable)
SEED_CAMPUS_NAME=Demo Campus University
SEED_CAMPUS_SLUG=demo-campus
SEED_CITY=Pune
SEED_STATE=Maharashtra
SEED_PINCODE=411001
SEED_EMAIL_DOMAIN=student.example.edu
SEED_SELLER_EMAIL=seller@student.example.edu
SEED_BUYER_EMAIL=buyer@student.example.edu
SEED_ADMIN_EMAIL=admin@campuscart.local
SEED_SELLER_PASSWORD=REPLACE_WITH_DEV_SELLER_PASSWORD
SEED_BUYER_PASSWORD=REPLACE_WITH_DEV_BUYER_PASSWORD
SEED_ADMIN_PASSWORD=REPLACE_WITH_DEV_ADMIN_PASSWORD
